<?xml version="1.0" encoding="utf-8"?>
<!-- Правила для API 31+: шифротекст ключа OpenRouter не покидает устройство (SPEC §11). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
